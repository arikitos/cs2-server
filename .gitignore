.env

# Steam installation and operator-owned state.
server/cs2/
server/state/*
!server/state/.gitkeep

# Local build and test output.
**/bin/
**/obj/
**/__pycache__/
*.py[cod]
*.tmp
.pytest_cache/
.coverage
htmlcov/

# Download and extraction scratch.
downloads/

# Operator-specific corporate CA certificates stay local to each machine.
panel/certificates/*
!panel/certificates/README.md
