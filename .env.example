# Copy this file to .env and edit the values.

# --- Steam / server identity ---
SRCDS_TOKEN=
CS2_SERVERNAME=
CS2_PASSWORD=
CS2_RCON_PASSWORD=
CS2_PORT=27015
CS2_TV_PORT=27020

# Runtime image is deliberately pinned by digest.
CS2_BASE_IMAGE=joedwards32/cs2@sha256:41b826d6280d1aa9e41c866a6d88cc7f523e027f16c47a313b20c2d7a17f2680

# Maintenance updater. Leave confirmation empty during normal operation.
CS2_UPDATER_MODE=update
CS2_UPDATER_CONFIRM=

# Persistent CS2 install and manager paths on the host.
CS2_DATA_PATH=./server
MANAGER_PATH=./manager

# HeroShift release overlay. The root installers verify HeroShift-vX.Y.Z.zip
# and replace this directory without rebuilding Docker images.
HEROSHIFT_RELEASE_PATH=./manager/releases/heroshift/current

# Panel login.
PANEL_USERNAME=
PANEL_PASSWORD=
PANEL_PORT=8080
PANEL_BIND=127.0.0.1

# Optional comma-separated map allowlist.
# CS2_ALLOWED_MAPS=de_ancient,de_anubis,de_dust2,de_inferno,de_mirage,de_nuke,de_overpass,de_train,de_vertigo
