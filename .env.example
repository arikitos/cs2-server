# Copy this file to .env and edit the values.

# --- Steam / server identity ---
SRCDS_TOKEN=
# Base name only. Each mode appends its own profile name + " Server"
# (see compose.yml), e.g. "Arik's Faceit Server", "Arik's Retake Server",
# "Arik's SuperHero Server", "Arik's GunGame Server".
CS2_SERVERNAME=Arik's
CS2_PASSWORD=
CS2_RCON_PASSWORD=
CS2_PORT=27015
CS2_TV_PORT=27020
CS2_STARTMAP=de_dust2

# --- Pinned runtime base image (Improvment.md section 16.6) ---
# Do NOT use joedwards32/cs2:latest for runtime. Pin an exact digest.
# Updating this is a deliberate maintenance step, not a normal restart.
CS2_BASE_IMAGE=joedwards32/cs2@sha256:41b826d6280d1aa9e41c866a6d88cc7f523e027f16c47a313b20c2d7a17f2680

# --- Per-mode server capacity (max player slots at process start) ---
# FaceIt / HeroShift / GunGame: 2..10   Retake: odd 3/5/7/9
FACEIT_CAPACITY=10
RETAKE_CAPACITY=7
SUPERHEROES_CAPACITY=10
GUNGAME_CAPACITY=10

# --- Maintenance updater (SteamCMD). Leave CONFIRM empty for safety. ---
# The panel sets these when an Owner explicitly runs an update.
# CS2_UPDATER_MODE: update | validate | repair-metamod
CS2_UPDATER_MODE=update
CS2_UPDATER_CONFIRM=

# Existing CS2 dedicated-server directory on the host.
# Expected content: game/, bin/, etc. This is NOT the steamcmd executable folder.
# Relative paths are resolved from this project directory.
CS2_DATA_PATH=./server

# This Manager project directory on the host (used by the panel-rebuild workflow).
# Relative paths are resolved from this project directory.
MANAGER_PATH=./manager

# --- Panel login. Change both values. ---
PANEL_USERNAME=
PANEL_PASSWORD=
PANEL_PORT=8080

# Optional: bind only to localhost for safer access.
PANEL_BIND=127.0.0.1

# Optional: override the allowed map list (comma separated).
# CS2_ALLOWED_MAPS=de_ancient,de_anubis,de_dust2,de_inferno,de_mirage,de_nuke,de_overpass,de_train,de_vertigo
