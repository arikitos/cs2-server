{
  "id": "retake",
  "label": "Retake",
  "implementation": "Powered by Retakes plugin + Instadefuse",
  "order": 20,
  "requires": {
    "metamod": "2.0.0-git1410",
    "counterstrikesharp": "1.0.371"
  },
  "startup": {
    "game_alias": "competitive",
    "mode_cfg": "mode_retake.cfg",
    "runtime_cfg": "panel_runtime.cfg"
  },
  "settings": {
    "formats": [
      {
        "key": "5v4",
        "label": "5v4",
        "detail": "9 players - 5 CT retake vs 4 T",
        "capacity": 9,
        "team_size": 5,
        "default": true,
        "plugin_config": {
          "config": "RetakesPlugin.json",
          "set": {
            "GameSettings.MaxPlayers": 9,
            "TeamSettings.TerroristRatio": 0.45
          }
        }
      },
      {
        "key": "4v3",
        "label": "4v3",
        "detail": "7 players - 4 CT retake vs 3 T",
        "capacity": 7,
        "team_size": 4,
        "plugin_config": {
          "config": "RetakesPlugin.json",
          "set": {
            "GameSettings.MaxPlayers": 7,
            "TeamSettings.TerroristRatio": 0.43
          }
        }
      }
    ],
    "defaults": {
      "format": "5v4",
      "map_pool": [
        "de_dust2",
        "de_mirage",
        "de_inferno",
        "de_nuke",
        "de_ancient",
        "de_anubis",
        "de_overpass"
      ],
      "hostname": "Retake Server",
      "lan": false,
      "cheats": false,
      "allow_lobby_connect_only": false,
      "limit_teams": 0,
      "auto_team_balance": false,
      "spectators_max": 2,
      "max_rounds": 24,
      "freezetime": 15,
      "warmup_time": 30,
      "round_time": 1.92,
      "buy_time": 20,
      "c4_timer": 40,
      "start_money": 800,
      "max_money": 16000,
      "bot_quota": 9,
      "bot_quota_mode": "match",
      "bot_difficulty": 3,
      "bot_chatter": "normal",
      "bot_join_after_player": true,
      "friendly_fire": "off",
      "ff_bullet_reduction": 0.33,
      "ff_grenade_reduction": 0.25,
      "ff_other_reduction": 0.4,
      "tk_punish": false,
      "overtime": false,
      "overtime_max_rounds": 6
    },
    "extra_cfg": []
  },
  "plugins": [
    {
      "name": "RetakesPlugin",
      "role": "plugin",
      "verify": {
        "required": true,
        "aliases": [
          "retake"
        ]
      },
      "mounts": [
        {
          "source": "release/plugins/RetakesPlugin",
          "target": "addons/counterstrikesharp/plugins/RetakesPlugin"
        }
      ]
    },
    {
      "name": "RetakesPluginShared",
      "role": "util",
      "verify": {
        "required": false,
        "aliases": []
      },
      "mounts": [
        {
          "source": "release/utils/RetakesPluginShared",
          "target": "addons/counterstrikesharp/shared/RetakesPluginShared"
        }
      ]
    },
    {
      "name": "Instadefuse",
      "role": "util",
      "verify": {
        "required": true,
        "aliases": [
          "instadefuse",
          "insta defuse"
        ]
      },
      "mounts": [
        {
          "source": "release/utils/InstadefusePlugin",
          "target": "addons/counterstrikesharp/plugins/InstadefusePlugin"
        }
      ]
    },
    {
      "name": "Instaplant",
      "role": "util",
      "verify": {
        "required": false,
        "aliases": [
          "instaplant",
          "insta plant"
        ]
      },
      "mounts": [
        {
          "source": "release/utils/InstaplantPlugin",
          "optional": true,
          "target": "addons/counterstrikesharp/plugins/InstaplantPlugin"
        }
      ]
    },
    {
      "name": "PanelBridge",
      "role": "util",
      "verify": {
        "required": false,
        "aliases": [
          "panel bridge",
          "panelbridge"
        ]
      },
      "build": {
        "project": "components/panelbridge/src/PanelBridge",
        "shared": true
      },
      "mounts": [
        {
          "source": "components/panelbridge/release/plugins/PanelBridge",
          "shared": true,
          "target": "addons/counterstrikesharp/plugins/PanelBridge"
        }
      ]
    },
    {
      "name": "ClutchAnnounce",
      "role": "util",
      "verify": {
        "required": false,
        "aliases": [
          "clutch announce",
          "clutchannounce"
        ]
      },
      "mounts": [
        {
          "source": "components/clutch-announce/release/plugins/ClutchAnnouncePlugin",
          "shared": true,
          "optional": true,
          "target": "addons/counterstrikesharp/plugins/ClutchAnnouncePlugin"
        }
      ]
    }
  ],
  "configs": [
    {
      "name": "server.cfg",
      "source": "cfg/server.cfg",
      "shared": true,
      "kind": "file",
      "target": "cfg/server.cfg"
    },
    {
      "name": "RetakesPlugin.json",
      "source": "config/RetakesPlugin.json",
      "kind": "file",
      "target": "addons/counterstrikesharp/configs/plugins/RetakesPlugin/RetakesPlugin.json"
    }
  ],
  "actions": [
    {
      "key": "force_a",
      "label": "Force Bombsite A",
      "cmd": "css_forcebombsite A",
      "impact": "Next rounds",
      "description": "Forces future retake rounds to use bombsite A.",
      "confirm": false,
      "group": "match"
    },
    {
      "key": "force_b",
      "label": "Force Bombsite B",
      "cmd": "css_forcebombsite B",
      "impact": "Next rounds",
      "description": "Forces future retake rounds to use bombsite B.",
      "confirm": false,
      "group": "match"
    },
    {
      "key": "force_auto",
      "label": "Restore Automatic Bombsite",
      "cmd": "css_forcebombsitestop",
      "impact": "Next rounds",
      "description": "Restores automatic bombsite selection.",
      "confirm": false,
      "group": "match"
    },
    {
      "key": "scramble",
      "label": "Scramble Teams",
      "cmd": "css_scramble",
      "impact": "Players",
      "description": "Reassigns players between teams at the end of the round.",
      "confirm": true,
      "group": "teams"
    },
    {
      "key": "scramble_teams",
      "label": "Scramble Teams Now",
      "cmd": "css_scrambleteams",
      "impact": "Players",
      "description": "Immediately reassigns players between teams.",
      "confirm": true,
      "group": "teams"
    },
    {
      "key": "voices",
      "label": "Toggle Bombsite Voices",
      "cmd": "css_voices",
      "impact": "In-game setting",
      "description": "Toggles the bombsite announcement voice lines.",
      "confirm": false,
      "group": "match"
    },
    {
      "key": "map_config",
      "label": "Show Map Config",
      "cmd": "css_mapconfig",
      "impact": "Read only",
      "description": "Prints the active retake map config.",
      "confirm": false,
      "group": "readonly"
    },
    {
      "key": "map_configs",
      "label": "List Map Configs",
      "cmd": "css_mapconfigs",
      "impact": "Read only",
      "description": "Lists every available retake map config.",
      "confirm": false,
      "group": "readonly"
    },
    {
      "key": "set_map_config",
      "label": "Set Map Config",
      "cmd": "css_setmapconfig",
      "impact": "Next rounds",
      "description": "Selects a retake map config. Append the config name.",
      "confirm": true,
      "group": "map",
      "arg_hint": "<config>"
    },
    {
      "key": "load_map_config",
      "label": "Reload Map Config",
      "cmd": "css_loadmapconfig",
      "impact": "Next rounds",
      "description": "Reloads the retake config for the current map.",
      "confirm": true,
      "group": "map"
    },
    {
      "key": "show_spawns",
      "label": "Show Spawns",
      "cmd": "css_showspawns",
      "impact": "In-game overlay",
      "description": "Draws the configured retake spawns.",
      "confirm": false,
      "group": "plugin"
    },
    {
      "key": "hide_spawns",
      "label": "Hide Spawns",
      "cmd": "css_hidespawns",
      "impact": "In-game overlay",
      "description": "Hides the retake spawn overlay.",
      "confirm": false,
      "group": "plugin"
    },
    {
      "key": "show_queue",
      "label": "Show Retake Queue",
      "cmd": "css_debugqueues",
      "impact": "Read only",
      "description": "Prints the current retake queue.",
      "confirm": false,
      "group": "readonly"
    }
  ]
}
