{
  "id": "retake",
  "label": "Retake",
  "implementation": "Powered by Retakes plugin + Instadefuse",
  "order": 20,
  "requires": {
    "metamod": "2.0.0-git1410",
    "counterstrikesharp": "1.0.371"
  },
  "startup": {
    "game_alias": "competitive",
    "mode_cfg": "mode_retake.cfg",
    "runtime_cfg": "panel_runtime.cfg"
  },
  "settings": {
    "capacity": { "min": 3, "max": 10 },
    "defaults": {
      "map": "de_dust2",
      "capacity": 9,
      "max_rounds": 24,
      "freezetime": 15,
      "friendly_fire": false,
      "bot_quota": 0
    },
    "extra_cfg": []
  },
  "plugins": [
    {
      "name": "RetakesPlugin",
      "role": "plugin",
      "verify": { "required": true, "aliases": ["retake"] },
      "mounts": [
        { "source": "plugins/RetakesPlugin", "target": "addons/counterstrikesharp/plugins/RetakesPlugin" }
      ]
    },
    {
      "name": "RetakesPluginShared",
      "role": "util",
      "verify": { "required": false, "aliases": [] },
      "mounts": [
        { "source": "utils/RetakesPluginShared", "target": "addons/counterstrikesharp/shared/RetakesPluginShared" }
      ]
    },
    {
      "name": "Instadefuse",
      "role": "util",
      "verify": { "required": true, "aliases": ["instadefuse", "insta defuse"] },
      "mounts": [
        { "source": "utils/InstadefusePlugin", "target": "addons/counterstrikesharp/plugins/InstadefusePlugin" }
      ]
    },
    {
      "name": "PanelBridge",
      "role": "util",
      "verify": { "required": false, "aliases": ["panel bridge", "panelbridge"] },
      "build": { "project": "plugins-src/PanelBridge", "shared": true },
      "mounts": [
        {
          "source": "plugins/PanelBridge",
          "shared": true,
          "target": "addons/counterstrikesharp/plugins/PanelBridge"
        }
      ]
    }
  ],
  "configs": [
    {
      "name": "server.cfg",
      "source": "cfg/server.cfg",
      "shared": true,
      "kind": "file",
      "target": "cfg/server.cfg"
    },
    {
      "name": "RetakesPlugin.json",
      "source": "config/RetakesPlugin.json",
      "kind": "file",
      "target": "addons/counterstrikesharp/configs/plugins/RetakesPlugin/RetakesPlugin.json"
    }
  ],
  "actions": [
    { "key": "force_a", "label": "Force Bombsite A", "cmd": "css_forcebombsite A", "impact": "Next rounds", "description": "Forces future retake rounds to use bombsite A.", "confirm": false },
    { "key": "force_b", "label": "Force Bombsite B", "cmd": "css_forcebombsite B", "impact": "Next rounds", "description": "Forces future retake rounds to use bombsite B.", "confirm": false },
    { "key": "force_auto", "label": "Restore Automatic Bombsite", "cmd": "css_forcebombsitestop", "impact": "Next rounds", "description": "Restores automatic bombsite selection.", "confirm": false },
    { "key": "scramble", "label": "Scramble Teams", "cmd": "css_scramble", "impact": "Players", "description": "Reassigns players between teams.", "confirm": true },
    { "key": "show_queue", "label": "Show Retake Queue", "cmd": "css_debugqueues", "impact": "Read only", "description": "Prints the current retake queue.", "confirm": false }
  ]
}
