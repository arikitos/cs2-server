{
  "id": "heroshift",
  "label": "HeroShift",
  "implementation": "Random skill every round (HeroShift)",
  "order": 40,
  "requires": {
    "metamod": "2.0.0-git1410",
    "counterstrikesharp": "1.0.371"
  },
  "startup": {
    "game_alias": "competitive",
    "mode_cfg": "mode_heroshift.cfg",
    "runtime_cfg": "panel_runtime.cfg"
  },
  "settings": {
    "formats": [
      {
        "key": "5v5",
        "label": "5v5",
        "detail": "10 players",
        "capacity": 10,
        "team_size": 5,
        "game_alias": "competitive",
        "default": true
      },
      {
        "key": "2v2",
        "label": "2v2",
        "detail": "4 players - Wingman",
        "capacity": 4,
        "team_size": 2,
        "game_alias": "wingman"
      },
      {
        "key": "1v1",
        "label": "1v1",
        "detail": "2 players",
        "capacity": 2,
        "team_size": 1,
        "game_alias": "competitive"
      }
    ],
    "defaults": {
      "format": "5v5",
      "map_pool": [
        "de_dust2",
        "de_mirage",
        "de_inferno",
        "de_nuke",
        "de_ancient",
        "de_anubis",
        "de_overpass"
      ],
      "hostname": "HeroShift Server",
      "lan": false,
      "cheats": false,
      "allow_lobby_connect_only": false,
      "limit_teams": 0,
      "auto_team_balance": false,
      "spectators_max": 2,
      "max_rounds": 24,
      "freezetime": 15,
      "warmup_time": 20,
      "round_time": 1.92,
      "buy_time": 20,
      "c4_timer": 40,
      "start_money": 800,
      "max_money": 16000,
      "bot_quota": 10,
      "bot_quota_mode": "fill",
      "bot_difficulty": 3,
      "bot_chatter": "normal",
      "bot_join_after_player": true,
      "friendly_fire": "off",
      "ff_bullet_reduction": 0.33,
      "ff_grenade_reduction": 0.25,
      "ff_other_reduction": 0.4,
      "tk_punish": false,
      "overtime": false,
      "overtime_max_rounds": 6
    },
    "extra_cfg": []
  },
  "plugins": [
    {
      "name": "HeroShift",
      "role": "plugin",
      "verify": {
        "required": true,
        "aliases": [
          "heroshift",
          "hero shift"
        ]
      },
      "mounts": [
        {
          "source": "release/plugins/HeroShift",
          "target": "addons/counterstrikesharp/plugins/HeroShift"
        },
        {
          "source": "release/gamedata/HeroShift.gamedata.json",
          "kind": "file",
          "target": "addons/counterstrikesharp/gamedata/HeroShift.gamedata.json"
        }
      ]
    },
    {
      "name": "RayTrace",
      "role": "util",
      "verify": {
        "required": true,
        "aliases": [
          "raytrace",
          "ray trace"
        ]
      },
      "mounts": [
        {
          "source": "release/utils/RayTrace/addons/metamod/RayTrace.vdf",
          "kind": "file",
          "target": "addons/metamod/RayTrace.vdf"
        },
        {
          "source": "release/utils/RayTrace/addons/RayTrace",
          "target": "addons/RayTrace"
        },
        {
          "source": "release/utils/RayTrace/addons/RayTrace/gamedata.json",
          "kind": "file",
          "absolute": true,
          "target": "/addons/RayTrace/gamedata.json"
        },
        {
          "source": "release/utils/RayTrace/addons/counterstrikesharp/plugins/RayTraceImpl",
          "target": "addons/counterstrikesharp/plugins/RayTraceImpl"
        },
        {
          "source": "release/utils/RayTrace/addons/counterstrikesharp/shared/RayTraceApi",
          "target": "addons/counterstrikesharp/shared/RayTraceApi"
        }
      ]
    },
    {
      "name": "PanelBridge",
      "role": "util",
      "verify": {
        "required": false,
        "aliases": [
          "panel bridge",
          "panelbridge"
        ]
      },
      "build": {
        "project": "plugins-src/PanelBridge",
        "shared": true
      },
      "mounts": [
        {
          "source": "plugins/PanelBridge",
          "shared": true,
          "target": "addons/counterstrikesharp/plugins/PanelBridge"
        }
      ]
    }
  ],
  "configs": [
    {
      "name": "server.cfg",
      "source": "cfg/server.cfg",
      "shared": true,
      "kind": "file",
      "target": "cfg/server.cfg"
    },
    {
      "name": "heroshift.json",
      "source": "config/heroshift.json",
      "kind": "file",
      "target": "addons/counterstrikesharp/plugins/HeroShift/configs/heroshift.json"
    }
  ],
  "actions": [
    {
      "key": "reload_skills",
      "label": "Reload HeroShift Config",
      "cmd": "css_reload",
      "impact": "Plugin config",
      "description": "Reloads heroshift.json atomically.",
      "confirm": false,
      "group": "plugin"
    },
    {
      "key": "restart_round",
      "label": "Restart Current Game",
      "cmd": "mp_restartgame 1",
      "impact": "In-game round",
      "description": "Restarts the game after one second.",
      "confirm": true,
      "group": "match"
    },
    {
      "key": "warmup_end",
      "label": "End Warmup",
      "cmd": "mp_warmup_end",
      "impact": "In-game phase",
      "description": "Ends warmup.",
      "confirm": true,
      "group": "match"
    },
    {
      "key": "kick_bots",
      "label": "Kick All Bots",
      "cmd": "bot_kick",
      "impact": "Players",
      "description": "Removes all bots.",
      "confirm": true,
      "group": "bots"
    }
  ]
}
