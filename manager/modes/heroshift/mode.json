{
  "id": "heroshift",
  "label": "HeroShift",
  "implementation": "Random skill every round (HeroShift)",
  "order": 40,
  "server_config": false,
  "requires": {
    "metamod": "2.0.0-git1410",
    "counterstrikesharp": "1.0.371"
  },
  "startup": {
    "game_alias": "competitive",
    "mode_cfg": "mode_heroshift.cfg",
    "runtime_cfg": "panel_runtime.cfg"
  },
  "settings": {
    "capacity": { "min": 2, "max": 10 },
    "defaults": {
      "map": "de_dust2",
      "capacity": 10,
      "max_rounds": 24,
      "freezetime": 15,
      "friendly_fire": false,
      "bot_quota": 0
    },
    "extra_cfg": []
  },
  "plugins": [
    {
      "name": "HeroShift",
      "role": "plugin",
      "verify": { "required": true, "aliases": ["heroshift", "hero shift"] },
      "mounts": [
        { "source": "plugins/HeroShift", "target": "addons/counterstrikesharp/plugins/HeroShift" },
        {
          "source": "gamedata/HeroShift.gamedata.json",
          "kind": "file",
          "target": "addons/counterstrikesharp/gamedata/HeroShift.gamedata.json"
        }
      ]
    },
    {
      "name": "RayTrace",
      "role": "util",
      "verify": { "required": true, "aliases": ["raytrace", "ray trace"] },
      "mounts": [
        { "source": "utils/RayTrace/addons/metamod/RayTrace.vdf", "kind": "file", "target": "addons/metamod/RayTrace.vdf" },
        { "source": "utils/RayTrace/addons/RayTrace", "target": "addons/RayTrace" },
        {
          "source": "utils/RayTrace/addons/RayTrace/gamedata.json",
          "kind": "file",
          "absolute": true,
          "target": "/addons/RayTrace/gamedata.json"
        },
        { "source": "utils/RayTrace/addons/counterstrikesharp/plugins/RayTraceImpl", "target": "addons/counterstrikesharp/plugins/RayTraceImpl" },
        { "source": "utils/RayTrace/addons/counterstrikesharp/shared/RayTraceApi", "target": "addons/counterstrikesharp/shared/RayTraceApi" }
      ]
    },
    {
      "name": "PanelBridge",
      "role": "util",
      "verify": { "required": false, "aliases": ["panel bridge", "panelbridge"] },
      "build": { "project": "plugins-src/PanelBridge", "shared": true },
      "mounts": [
        {
          "source": "plugins/PanelBridge",
          "shared": true,
          "target": "addons/counterstrikesharp/plugins/PanelBridge"
        }
      ]
    }
  ],
  "configs": [
    {
      "name": "server.cfg",
      "source": "cfg/server.cfg",
      "shared": true,
      "kind": "file",
      "target": "cfg/server.cfg"
    },
    {
      "name": "skillsInfo.json",
      "source": "plugins/HeroShift/configs/skillsInfo.json",
      "kind": "file",
      "target": "addons/counterstrikesharp/plugins/HeroShift/configs/skillsInfo.json"
    },
    {
      "name": "config.json",
      "source": "plugins/HeroShift/configs/config.json",
      "kind": "file",
      "target": "addons/counterstrikesharp/plugins/HeroShift/configs/config.json"
    }
  ],
  "actions": [
    { "key": "reload_skills", "label": "Reload Hero Config", "cmd": "css_heroshift_reload", "impact": "Plugin config", "description": "Reloads HeroShift config files.", "confirm": false },
    { "key": "restart_round", "label": "Restart Current Game", "cmd": "mp_restartgame 1", "impact": "In-game round", "description": "Restarts the game after one second.", "confirm": true },
    { "key": "warmup_end", "label": "End Warmup", "cmd": "mp_warmup_end", "impact": "In-game phase", "description": "Ends warmup.", "confirm": true },
    { "key": "kick_bots", "label": "Kick All Bots", "cmd": "bot_kick", "impact": "Players", "description": "Removes all bots.", "confirm": true }
  ]
}
