{
  "id": "superhero",
  "label": "SuperHero",
  "implementation": "Classic CS 1.6-style SuperHero Mod with Marvel-inspired heroes",
  "order": 30,
  "requires": {
    "metamod": "2.0.0-git1410",
    "counterstrikesharp": "1.0.371"
  },
  "startup": {
    "game_alias": "competitive",
    "mode_cfg": "mode_superhero.cfg",
    "runtime_cfg": "panel_runtime.cfg"
  },
  "settings": {
    "formats": [
      {"key":"5v5","label":"5v5","detail":"10 players","capacity":10,"team_size":5,"game_alias":"competitive","default":true},
      {"key":"2v2","label":"2v2","detail":"4 players - Wingman","capacity":4,"team_size":2,"game_alias":"wingman"},
      {"key":"1v1","label":"1v1","detail":"2 players","capacity":2,"team_size":1,"game_alias":"competitive"}
    ],
    "defaults": {
      "format": "5v5",
      "map_pool": ["de_dust2","de_mirage","de_inferno","de_nuke","de_ancient","de_anubis","de_overpass"],
      "hostname": "SuperHero Server",
      "lan": false,
      "cheats": false,
      "allow_lobby_connect_only": false,
      "limit_teams": 0,
      "auto_team_balance": false,
      "spectators_max": 2,
      "max_rounds": 24,
      "freezetime": 15,
      "warmup_time": 20,
      "round_time": 1.92,
      "buy_time": 20,
      "c4_timer": 40,
      "start_money": 800,
      "max_money": 16000,
      "bot_quota": 10,
      "bot_quota_mode": "fill",
      "bot_difficulty": 3,
      "bot_chatter": "normal",
      "bot_join_after_player": true,
      "friendly_fire": "off",
      "ff_bullet_reduction": 0.33,
      "ff_grenade_reduction": 0.25,
      "ff_other_reduction": 0.4,
      "tk_punish": false,
      "overtime": false,
      "overtime_max_rounds": 6
    },
    "extra_cfg": []
  },
  "plugins": [
    {
      "name":"SuperHeroMod","role":"plugin",
      "verify":{"required":true,"aliases":["superhero mod","superheromod","superhero"]},
      "mounts":[{"source":"release/plugins/SuperHeroMod","target":"addons/counterstrikesharp/plugins/SuperHeroMod"}]
    },
    {
      "name":"PanelBridge","role":"util",
      "verify":{"required":false,"aliases":["panel bridge","panelbridge"]},
      "build":{"project":"components/panelbridge/src/PanelBridge","shared":true},
      "mounts":[{"source":"components/panelbridge/release/plugins/PanelBridge","shared":true,"target":"addons/counterstrikesharp/plugins/PanelBridge"}]
    },
    {
      "name":"ClutchAnnounce","role":"util",
      "verify":{"required":false,"aliases":["clutch announce","clutchannounce"]},
      "mounts":[{"source":"components/clutch-announce/release/plugins/ClutchAnnouncePlugin","shared":true,"optional":true,"target":"addons/counterstrikesharp/plugins/ClutchAnnouncePlugin"}]
    }
  ],
  "configs": [
    {"name":"server.cfg","source":"cfg/server.cfg","shared":true,"kind":"file","target":"cfg/server.cfg"},
    {"name":"SuperHeroMod.json","source":"config/SuperHeroMod.json","kind":"file","target":"addons/counterstrikesharp/configs/plugins/SuperHeroMod/SuperHeroMod.json"},
    {"name":"heroes.json","source":"config/heroes.json","kind":"file","target":"addons/counterstrikesharp/configs/plugins/SuperHeroMod/heroes.json"}
  ],
  "actions": [
    {"key":"reload_heroes","label":"Reload SuperHero Config","cmd":"css_shreload","impact":"Plugin config","description":"Reloads SuperHeroMod.json and heroes.json with rollback on validation failure.","confirm":false,"group":"plugin"}
  ]
}
