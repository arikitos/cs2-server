    {
      "name": "PanelBridge",
      "role": "util",
      "verify": {
        "required": false,
        "aliases": [
          "panel bridge",
          "panelbridge"
        ]
      },
      "build": {
        "project": "components/panelbridge/src/PanelBridge",
        "shared": true
      },
      "mounts": [
        {
          "source": "components/panelbridge/release/plugins/PanelBridge",
          "shared": true,
          "target": "addons/counterstrikesharp/plugins/PanelBridge"
        }
      ]
    },
    {
      "name": "ClutchAnnounce",
      "role": "util",
      "verify": {
        "required": false,
        "aliases": [
          "clutch announce",
          "clutchannounce"
        ]
      },
      "mounts": [
        {
          "source": "components/clutch-announce/release/plugins/ClutchAnnouncePlugin",
          "shared": true,
          "optional": true,
          "target": "addons/counterstrikesharp/plugins/ClutchAnnouncePlugin"
        }
      ]
    }
  ],
  "configs": [
    {
      "name": "server.cfg",
      "source": "cfg/server.cfg",
      "shared": true,
      "kind": "file",
      "target": "cfg/server.cfg"
    },
    {
      "name": "WarcraftClassic.json",
      "source": "config/WarcraftClassic.json",
      "kind": "file",
      "target": "addons/counterstrikesharp/configs/plugins/WarcraftClassic/WarcraftClassic.json"
    }
  ],
  "actions": [
    {
      "key": "restart_round",
      "label": "Restart Current Game",
      "cmd": "mp_restartgame 1",
      "impact": "In-game round",
      "description": "Restarts the game after one second.",
      "confirm": true,
      "group": "match"
    },
    {
      "key": "warmup_end",
      "label": "End Warmup",
      "cmd": "mp_warmup_end",
      "impact": "In-game phase",
      "description": "Ends warmup.",
      "confirm": true,
      "group": "match"
    },
    {
      "key": "kick_bots",
      "label": "Kick All Bots",
      "cmd": "bot_kick",
      "impact": "Players",
      "description": "Removes all bots.",
      "confirm": true,
      "group": "bots"
    }
  ]
}
