{
  "id": "faceit",
  "label": "FaceIt",
  "implementation": "Powered by MatchZy",
  "order": 10,
  "requires": {
    "metamod": "2.0.0-git1410",
    "counterstrikesharp": "1.0.371"
  },
  "startup": {
    "game_alias": "competitive",
    "mode_cfg": "mode_faceit.cfg",
    "runtime_cfg": "panel_runtime.cfg"
  },
  "settings": {
    "capacity": { "min": 2, "max": 10 },
    "defaults": {
      "map": "de_dust2",
      "capacity": 10,
      "max_rounds": 24,
      "freezetime": 15,
      "friendly_fire": false,
      "bot_quota": 0
    },
    "extra_cfg": ["matchzy_autostart_mode 1"]
  },
  "plugins": [
    {
      "name": "MatchZy",
      "role": "plugin",
      "verify": { "required": true, "aliases": ["matchzy"] },
      "mounts": [
        { "source": "plugins/MatchZy", "target": "addons/counterstrikesharp/plugins/MatchZy" }
      ]
    },
    {
      "name": "AutoReady",
      "role": "util",
      "verify": { "required": true, "aliases": ["auto ready", "autoready"] },
      "build": { "project": "utils/AutoReady.src" },
      "mounts": [
        { "source": "utils/AutoReady", "target": "addons/counterstrikesharp/plugins/AutoReady" }
      ]
    },
    {
      "name": "PanelBridge",
      "role": "util",
      "verify": { "required": false, "aliases": ["panel bridge", "panelbridge"] },
      "build": { "project": "plugins-src/PanelBridge", "shared": true },
      "mounts": [
        {
          "source": "plugins/PanelBridge",
          "shared": true,
          "target": "addons/counterstrikesharp/plugins/PanelBridge"
        }
      ]
    }
  ],
  "configs": [
    {
      "name": "server.cfg",
      "source": "cfg/server.cfg",
      "shared": true,
      "kind": "file",
      "target": "cfg/server.cfg"
    },
    {
      "name": "MatchZy cfg",
      "source": "cfg/MatchZy",
      "target": "cfg/MatchZy"
    }
  ],
  "actions": [
    { "key": "start", "label": "Start Match", "cmd": "css_start", "impact": "In-game match", "description": "Starts the MatchZy match flow.", "confirm": true },
    { "key": "force_start", "label": "Force Start Match", "cmd": "css_forcestart", "impact": "In-game match", "description": "Starts the match immediately.", "confirm": true },
    { "key": "restart", "label": "Restart Match", "cmd": "css_restart", "impact": "In-game match", "description": "Resets the current MatchZy match.", "confirm": true },
    { "key": "end", "label": "End Match", "cmd": "css_endmatch", "impact": "In-game match", "description": "Ends the active MatchZy match.", "confirm": true },
    { "key": "pause", "label": "Pause Match", "cmd": "css_pause", "impact": "In-game match", "description": "Requests a tactical pause.", "confirm": false },
    { "key": "unpause", "label": "Unpause Match", "cmd": "css_unpause", "impact": "In-game match", "description": "Resumes a paused match.", "confirm": false },
    { "key": "force_pause", "label": "Force Pause", "cmd": "css_forcepause", "impact": "In-game match", "description": "Immediately pauses the match.", "confirm": true },
    { "key": "force_unpause", "label": "Force Unpause", "cmd": "css_forceunpause", "impact": "In-game match", "description": "Immediately resumes the match.", "confirm": true },
    { "key": "knife", "label": "Toggle Knife Round", "cmd": "css_roundknife", "impact": "In-game setting", "description": "Toggles the knife round.", "confirm": false },
    { "key": "skip_veto", "label": "Skip Veto", "cmd": "css_skipveto", "impact": "In-game match", "description": "Skips the current veto phase.", "confirm": true },
    { "key": "settings", "label": "Show Match Settings", "cmd": "css_settings", "impact": "Read only", "description": "Prints MatchZy settings.", "confirm": false }
  ]
}
